{
    "name": "solarepc-pro-frontend",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "test:ci": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:chrome": "playwright test --project=chromium-latest",
        "test:e2e:firefox": "playwright test --project=firefox-latest",
        "test:e2e:safari": "playwright test --project=webkit-latest",
        "test:e2e:edge": "playwright test --project=edge-latest",
        "test:e2e:debug": "playwright test --debug",
        "test:performance": "vitest run performance.test.tsx --reporter=verbose",
        "test:performance:report": "VITE_PERFORMANCE_REPORT=true vitest run performance.test.tsx --reporter=json --outputFile=performance-report-vitest.json",
        "test:performance:baseline": "npm run test:performance:report && cp benchmarks/frontend-latest.json benchmarks/baseline.json"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.2.2",
        "@radix-ui/react-alert-dialog": "^1.1.15",
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slider": "^1.3.6",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@tailwindcss/postcss": "^4.1.18",
        "@tanstack/react-query": "^5.17.0",
        "@tanstack/react-query-devtools": "^5.91.3",
        "@turf/turf": "^6.5.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "firebase": "^10.14.1",
        "leaflet": "^1.9.4",
        "lucide-react": "^0.563.0",
        "next": "14.1.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-error-boundary": "^6.1.0",
        "react-hook-form": "^7.71.1",
        "react-leaflet": "^4.2.1",
        "recharts": "^3.7.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.4.0",
        "tailwindcss-animate": "^1.0.7",
        "zod": "^4.3.6",
        "zustand": "^5.0.11"
    },
    "devDependencies": {
        "@playwright/test": "^1.48.0",
        "@testing-library/jest-dom": "^6.4.2",
        "@testing-library/react": "^14.2.1",
        "@testing-library/user-event": "^14.5.2",
        "@types/leaflet": "^1.9.12",
        "@types/node": "^20.11.0",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@vitejs/plugin-react": "^4.2.1",
        "@vitest/coverage-v8": "^1.3.1",
        "@vitest/ui": "^1.3.1",
        "autoprefixer": "^10.4.24",
        "eslint": "^8.56.0",
        "eslint-config-next": "14.1.0",
        "jsdom": "^24.0.0",
        "msw": "^2.2.1",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.18",
        "typescript": "^5.3.0",
        "vitest": "^1.3.1"
    }
}